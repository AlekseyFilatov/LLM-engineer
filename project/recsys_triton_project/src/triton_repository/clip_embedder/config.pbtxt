name: "clip_embedder"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1, 77 ]
  },
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [ -1, 3, 224, 224 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1, 77 ]
  }
]

output [
  {
    name: "text_embeds"
    data_type: TYPE_FP32
    dims: [ -1, 512 ]
  },
  {
    name: "image_embeds"
    data_type: TYPE_FP32
    dims: [ -1, 512 ]
  }
]

# Современный синтаксис включения CUDA Execution Provider для RTX 5070 Ti
parameters {
  key: "execution_providers"
  value: { string_value: "CUDAExecutionProvider" }
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
