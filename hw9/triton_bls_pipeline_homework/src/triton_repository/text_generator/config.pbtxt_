name: "text_generator"
backend: "onnxruntime"
max_batch_size: 0

# ЖЕСТКАЯ СТРУКТУРА ТЕНЗОРОВ НАСТОЯЩЕГО ONNX-ГРАФА QWEN2.5
input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1, -1 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1, -1 ]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ -1, -1, 151936 ]
  }
]

parameters {
  key: "execution_providers"
  value: { string_value: "CPUExecutionProvider" }
}
